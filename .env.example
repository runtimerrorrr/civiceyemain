# CivicEye Frontend Environment Configuration

# Backend API Base URL
# Default local Flask server port is 5000:
VITE_API_BASE_URL=http://localhost:5000

# Optional: Google Gemini API Key for Live Computer Vision Analysis
# Get your API key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Default City/Region for Civic Geotagging
VITE_DEFAULT_CITY=Visakhapatnam
